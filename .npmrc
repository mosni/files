# @vidstack/react@0.6.15 (D-139, pinned deliberately) declares a peerDependency on react@^18 and has not
# been updated for React 19 in that release line, so a strict npm install ERESOLVEs on this repo's react@19.
# legacy-peer-deps skips that check; it is functionally compatible in practice (Wave F, E5 session 2), and
# this is the standard workaround for a below-bar, slow-moving dependency rather than a reason to swap it.
legacy-peer-deps=true
